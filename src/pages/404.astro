---
import { LinkBroken } from 'reicon-astro';
import PortfolioButton from '@/components/portfolio/PortfolioButton.astro';
import {
  Empty,
  EmptyContent,
  EmptyDescription,
  EmptyHeader,
  EmptyMedia,
  EmptyTitle,
} from '@/components/ui/empty';
import Layout from '@/layouts/Layout.astro';
---

<Layout>
  <main id="main" class="grid min-h-dvh place-items-center px-6">
    <Empty>
      <EmptyHeader>
        <EmptyMedia variant="icon">
          <LinkBroken />
        </EmptyMedia>
        <EmptyTitle>404 - Page Not Found</EmptyTitle>
        <EmptyDescription> The page you are looking for does not exist. </EmptyDescription>
      </EmptyHeader>
      <EmptyContent>
        <PortfolioButton href="/" compact>Go home</PortfolioButton>
      </EmptyContent>
    </Empty>
  </main>
</Layout>
