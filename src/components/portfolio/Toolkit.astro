---
import { Icon } from 'astro-icon/components';
import { Separator } from '@/components/starwind/separator';
import { tools } from '../../data/portfolio';
---

<section class="toolkit" aria-labelledby="toolkit-title">
  <Separator />
  <div class="shell toolkit-inner">
    <h2 class="toolkit-title" id="toolkit-title"> Toolkit </h2>
    <div class="toolkit-list">
      <div class="toolkit-track">
        {tools.map((tool) => (
          <span class="toolkit-item"><Icon name={tool.icon} title={tool.name} class="toolkit-icon" /></span>
        ))}
      </div>
      <div class="toolkit-track" aria-hidden="true">
        {tools.map((tool) => (
          <span class="toolkit-item"><Icon name={tool.icon} class="toolkit-icon" /></span>
        ))}
      </div>
    </div>
  </div>
  <Separator />
</section>

<style>
:global(.toolkit-inner) {
  min-height: 112px;
  display: grid;
  grid-template-columns: 0.55fr minmax(0, 2fr);
  align-items: center;
  gap: 3rem;
}

:global(.toolkit-title) {
  color: var(--muted-foreground);
  font-size: 0.95rem;
  font-weight: 520;
}

:global(.toolkit-list) {
  min-width: 0;
  display: flex;
  overflow: hidden;
  user-select: none;
}

.toolkit-track {
  display: flex;
  min-width: max-content;
  flex-shrink: 0;
  align-items: center;
  gap: clamp(2.5rem, 6vw, 6rem);
  padding-right: clamp(2.5rem, 6vw, 6rem);
  animation: toolkit-scroll 28s linear infinite;
}

.toolkit-list:hover .toolkit-track { animation-play-state: paused; }

@keyframes toolkit-scroll {
  to { transform: translateX(-100%); }
}

:global(.toolkit-item) {
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}

:global(.toolkit-icon) {
  width: auto;
  height: clamp(2rem, 3vw, 2.75rem);
  max-width: 8rem;
}

@media (max-width: 900px) {
  :global(.toolkit-inner) {
    padding-block: 2rem;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  .toolkit-track {
    animation: none;
  }

  .toolkit-track[aria-hidden="true"] {
    display: none;
  }
}
</style>
