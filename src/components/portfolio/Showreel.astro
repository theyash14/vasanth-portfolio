---
import { Section } from '@/components/ui/section';
import { bunnyStreamLibraryId, showreel } from '../../data/portfolio';
import BunnyVideo from './BunnyVideo.astro';
---

<Section class="showreel shell gap-0" id="showreel" aria-labelledby="showreel-title">
  <BunnyVideo
    class="showreel-player"
    libraryId={bunnyStreamLibraryId}
    videoId={showreel.bunnyVideoId}
    title={showreel.title}
    aspect="landscape"
    muted={false}
    preload={true}
  />
  <div class="media-caption">
    <h2 id="showreel-title">A selection in motion</h2>
  </div>
</Section>

<style>
:global(.showreel) {
  padding-block: 5rem 8rem;
}

:global(.showreel-player) {
  aspect-ratio: 16 / 9;
}

.media-caption {
  min-height: 68px;
  padding-top: 1.25rem;
  display: flex;
  align-items: flex-start;
}

h2 {
  font-size: clamp(1.45rem, 2.2vw, 2rem);
  font-weight: 450;
  letter-spacing: -0.035em;
}

@media (max-width: 700px) {
  :global(.showreel) {
    padding-block: 1rem 5.5rem;
  }

  .media-caption {
    min-height: 72px;
  }
}
</style>
