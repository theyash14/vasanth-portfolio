---
import type { HTMLAttributes } from 'astro/types';

import { cn } from '@/lib/utils';

type Aspect = 'landscape' | 'portrait' | 'square';

type Props = Omit<HTMLAttributes<'div'>, 'title'> & {
  libraryId: string;
  videoId: string;
  title: string;
  aspect?: Aspect;
  autoplay?: boolean;
  loop?: boolean;
  muted?: boolean;
  preload?: boolean;
};

const {
  libraryId,
  videoId,
  title,
  aspect = 'landscape',
  autoplay = false,
  loop = false,
  muted = true,
  preload = true,
  class: className,
  ...props
} = Astro.props;

const parameters = new URLSearchParams({
  autoplay: String(autoplay),
  loop: String(loop),
  muted: String(muted),
  preload: String(preload),
  responsive: 'true',
});
const embedUrl = `https://player.mediadelivery.net/embed/${libraryId}/${videoId}?${parameters}`;
---

<div
  class={cn('bunny-video', className)}
  data-bunny-player
  data-aspect={aspect}
  data-status="idle"
  {...props}
>
  <iframe
    data-bunny-embed
    data-src={embedUrl}
    title={title}
    allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture; fullscreen"
    allowfullscreen
  />
  <p class="bunny-status" aria-live="polite">
    <span data-loading>Loading video</span>
    <span data-error hidden>Video unavailable</span>
  </p>
</div>

<script>
const players = document.querySelectorAll<HTMLElement>('[data-bunny-player]');

const loadPlayer = (player: HTMLElement) => {
  const embed = player.querySelector<HTMLIFrameElement>('[data-bunny-embed]');
  if (!embed || embed.src || !embed.dataset.src) return;

  player.dataset.status = 'loading';
  const failureTimer = window.setTimeout(() => {
    if (player.dataset.status === 'ready') return;
    player.dataset.status = 'error';
    player.querySelector<HTMLElement>('[data-loading]')?.setAttribute('hidden', '');
    player.querySelector<HTMLElement>('[data-error]')?.removeAttribute('hidden');
  }, 10000);

  embed.addEventListener(
    'load',
    () => {
      window.clearTimeout(failureTimer);
      player.dataset.status = 'ready';
    },
    { once: true },
  );
  embed.src = embed.dataset.src;
};

const observer = new IntersectionObserver(
  (entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      loadPlayer(entry.target as HTMLElement);
      observer.unobserve(entry.target);
    });
  },
  { rootMargin: '240px', threshold: 0.01 },
);

players.forEach((player) => {
  if (player.dataset.playerReady === 'true') return;
  player.dataset.playerReady = 'true';
  observer.observe(player);
});
</script>

<style>
.bunny-video {
  position: relative;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  border-radius: var(--portfolio-media-radius);
  background: var(--portfolio-player-surface, #211317);
}

.bunny-video[data-aspect="portrait"] {
  aspect-ratio: 9 / 16;
}

.bunny-video[data-aspect="square"] {
  aspect-ratio: 1;
}

iframe {
  width: 100%;
  height: 100%;
  display: block;
  border: 0;
}

.bunny-status {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  margin: 0;
  padding: 1rem;
  background: var(--portfolio-player-surface, #211317);
  color: var(--portfolio-player-foreground, #f1ebdd);
  font-size: 0.85rem;
  letter-spacing: 0.02em;
  pointer-events: none;
  transition: opacity 0.25s var(--portfolio-ease);
}

.bunny-video[data-status="idle"] .bunny-status,
.bunny-video[data-status="ready"] .bunny-status {
  opacity: 0;
}

.bunny-video[data-status="error"] .bunny-status {
  color: var(--portfolio-player-accent, #9e5164);
}
</style>
