---
import { Tabs, TabsContent, TabsList, TabsTrigger } from '@/components/starwind/tabs';
import { bunnyStreamLibraryId, clients } from '../../data/portfolio';
import BunnyVideo from './BunnyVideo.astro';

const clientCollections = clients.map((client) => {
  const standardVideos = client.videos.filter((video) => video.format === 'video');
  const videoGroups = [...new Set(standardVideos.map((video) => video.aspect))].map((aspect) => ({
    aspect,
    videos: standardVideos.filter((video) => video.aspect === aspect),
  }));

  return {
    ...client,
    standardVideos,
    videoGroups,
    reels: client.videos.filter((video) => video.format === 'reel'),
  };
});
---

<section class="work" id="work" aria-labelledby="work-title">
  <div class="shell">
    <div class="section-heading">
      <h2 class="work-title" id="work-title">Client work</h2>
    </div>

    <Tabs defaultValue={clientCollections[0]?.id} class="gap-0">
      <TabsList class="client-tabs h-auto w-full bg-transparent p-0">
        {clientCollections.map((client) => (
          <TabsTrigger id={`${client.id}-tab`} class="client-tab" value={client.id}>
            {client.tab}
          </TabsTrigger>
        ))}
      </TabsList>

      {clientCollections.map((client) => (
        <TabsContent value={client.id} class="client-content">
          <div class="client-panel">
            <div class="client-intro">
              <h3>{client.name}</h3>
              <p>{client.summary}</p>
            </div>

            <div class="media-groups">
              {client.standardVideos.length > 0 && (
                <section class="media-group" aria-labelledby={`${client.id}-videos-title`}>
                  <div class="group-heading">
                    <h4 id={`${client.id}-videos-title`}>Videos</h4>
                    <p>{client.standardVideos.length} {client.standardVideos.length === 1 ? 'video' : 'videos'}</p>
                  </div>
                  <div class="video-aspect-groups">
                    {client.videoGroups.map((group, groupIndex) => (
                      <div class="video-aspect-group">
                        <ul
                          class="media-grid video-grid"
                          data-aspect={group.aspect}
                          aria-label={`${client.name} videos, group ${groupIndex + 1}`}
                        >
                          {group.videos.map((video, videoIndex) => (
                            <li class="media-card" data-aspect={video.aspect}>
                              <figure>
                                <BunnyVideo
                                  libraryId={bunnyStreamLibraryId}
                                  videoId={video.bunnyVideoId}
                                  title={`${client.name}, ${group.aspect} video ${videoIndex + 1}`}
                                  aspect={video.aspect}
                                />
                              </figure>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </section>
              )}

              {client.reels.length > 0 && (
                <section class="media-group" aria-labelledby={`${client.id}-reels-title`}>
                  <div class="group-heading">
                    <h4 id={`${client.id}-reels-title`}>Reels</h4>
                    <p>{client.reels.length} {client.reels.length === 1 ? 'reel' : 'reels'}</p>
                  </div>
                  <ul
                    class="media-grid reel-grid"
                    id={`${client.id}-reels`}
                    aria-label={`${client.name} reels`}
                  >
                    {client.reels.map((video, videoIndex) => (
                      <li class="media-card" data-aspect={video.aspect}>
                        <figure>
                          <BunnyVideo
                            libraryId={bunnyStreamLibraryId}
                            videoId={video.bunnyVideoId}
                            title={`${client.name}, reel ${videoIndex + 1}`}
                            aspect={video.aspect}
                          />
                        </figure>
                      </li>
                    ))}
                  </ul>
                </section>
              )}
            </div>
          </div>
        </TabsContent>
      ))}
    </Tabs>
  </div>
</section>

<style>
:global(.work) {
  padding-block: 6.5rem 8rem;
  border-top: 1px solid var(--border);
}

.section-heading {
  margin-bottom: 2.75rem;
}

:global(.work-title) {
  font-size: clamp(3.5rem, 6vw, 5.4rem);
  font-weight: 450;
  line-height: 0.96;
  letter-spacing: -0.06em;
}

:global(.client-tabs) {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  gap: 0.5rem;
  min-height: 0;
  background: transparent;
}

:global(.client-tab) {
  flex: 0 0 auto;
  min-width: max-content;
  min-height: 48px;
  padding: 0.75rem 0.95rem;
  border: 1px solid transparent;
  border-radius: var(--portfolio-button-radius);
  background: transparent;
  color: var(--muted-foreground);
  box-shadow: none;
  cursor: pointer;
  transition:
    background-color 0.2s ease,
    color 0.2s ease;
}

:global(.client-tab:not([data-state="active"]):not([data-active]):hover) {
  background: var(--muted);
  color: var(--foreground);
}

:global(.client-tab[data-state="active"]),
:global(.client-tab[data-active]) {
  background: var(--foreground);
  color: var(--background);
  font-weight: 620;
  box-shadow: none;
}

:global(.client-tab::after) {
  display: none;
}

:global(.client-panel) {
  padding-top: clamp(2.5rem, 5vw, 4.5rem);
}

:global(.client-content[data-state="active"]) {
  animation: client-content-in 180ms ease-out;
}

@keyframes client-content-in {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@media (prefers-reduced-motion: reduce) {
  :global(.client-content[data-state="active"]) {
    animation: none;
  }
}

.client-intro {
  margin-bottom: clamp(2.25rem, 4vw, 3.5rem);
}

.client-intro h3 {
  font-size: clamp(1.5rem, 2.2vw, 2rem);
  font-weight: 480;
  letter-spacing: -0.035em;
}

.client-intro > p {
  margin-top: 0.8rem;
  color: var(--muted-foreground);
  font-size: 1.02rem;
  line-height: 1.65;
}

.media-groups {
  display: grid;
  gap: clamp(3.5rem, 7vw, 6rem);
}

.media-group {
  padding-top: 1.25rem;
  border-top: 1px solid var(--border);
}

.group-heading {
  margin-bottom: 1.5rem;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 1rem;
}

.group-heading h4 {
  font-size: clamp(1.25rem, 2vw, 1.65rem);
  font-weight: 540;
  letter-spacing: -0.035em;
}

.group-heading p {
  color: var(--muted-foreground);
  font-size: 0.86rem;
  font-variant-numeric: tabular-nums;
}

.media-grid {
  margin: 0;
  padding: 0;
  display: grid;
  gap: clamp(1rem, 2vw, 1.5rem);
  list-style: none;
}

.video-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.video-aspect-groups {
  display: grid;
  gap: clamp(2rem, 4vw, 3rem);
}

.video-grid[data-aspect="square"] {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.reel-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

@media (max-width: 1280px) {
  :global(.client-tabs) {
    flex-wrap: nowrap;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-inline: contain;
    scrollbar-width: none;
  }

  :global(.client-tabs::-webkit-scrollbar) {
    display: none;
  }
}

@media (max-width: 700px) {
  :global(.work) {
    padding-block: 4.5rem 5.5rem;
  }

  :global(.work-title) {
    font-size: clamp(3rem, 14vw, 4rem);
  }

  :global(.client-tabs) {
    margin-inline: calc(var(--gutter) * -1);
    width: calc(100% + (var(--gutter) * 2));
    padding-inline: var(--gutter);
    scroll-padding-inline: var(--gutter);
  }

  .client-intro {
    margin-bottom: 2rem;
  }

  .media-groups {
    gap: 3.5rem;
  }

  .video-grid,
  .video-grid[data-aspect="square"] {
    grid-template-columns: 1fr;
  }

  .reel-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
</style>

<script>
document.querySelectorAll<HTMLElement>('.client-tabs').forEach((list) => {
  const revealSelectedTab = () => {
    if (list.scrollWidth <= list.clientWidth) return;

    const selected = list.querySelector<HTMLElement>('[role="tab"][aria-selected="true"]');
    selected?.scrollIntoView({
      behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
      block: 'nearest',
      inline: 'nearest',
    });
  };

  new MutationObserver(revealSelectedTab).observe(list, {
    attributes: true,
    attributeFilter: ['aria-selected'],
    subtree: true,
  });
});
</script>
