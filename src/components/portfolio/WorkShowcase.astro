---
import {
  Section,
  SectionContainer,
  SectionDescription,
  SectionTitle,
} from '@/components/ui/section';
import { Tabs, TabsContent, TabsList, TabsTrigger } from '@/components/ui/tabs';
import { bunnyStreamLibraryId, clients } from '../../data/portfolio';
import BunnyVideo from './BunnyVideo.astro';

const clientCollections = clients.map((client) => ({
  ...client,
  standardVideos: client.videos.filter((video) => video.format === 'video'),
  reels: client.videos.filter((video) => video.format === 'reel'),
}));

const reelPreviewLimit = 4;
---

<Section class="work" id="work" aria-labelledby="work-title">
  <SectionContainer class="shell max-w-none gap-0 px-0">
    <div class="section-heading">
      <SectionTitle as="h2" class="work-title" id="work-title"> Client edits </SectionTitle>
      <SectionDescription class="work-description">
        Thirty-eight videos, organised by client and body of work.
      </SectionDescription>
    </div>

    <Tabs defaultValue={clientCollections[0]?.id} class="gap-0">
      <TabsList variant="line" class="client-tabs h-auto w-full rounded-none p-0">
        {clientCollections.map((client) => (
          <TabsTrigger id={`${client.id}-tab`} class="client-tab" value={client.id}>
            {client.tab}
          </TabsTrigger>
        ))}
      </TabsList>

      {clientCollections.map((client, index) => (
        <TabsContent value={client.id} hidden={index !== 0}>
          <div class="client-panel">
            <div class="client-intro">
              <h3>{client.name}</h3>
              <p>{client.summary}</p>
            </div>

            <div class="media-groups">
              {client.standardVideos.length > 0 && (
                <section class="media-group" aria-labelledby={`${client.id}-videos-title`}>
                  <div class="group-heading">
                    <h4 id={`${client.id}-videos-title`}>Videos</h4>
                    <p>{client.standardVideos.length} {client.standardVideos.length === 1 ? 'video' : 'videos'}</p>
                  </div>
                  <ul class="media-grid video-grid" aria-label={`${client.name} standard videos`}>
                    {client.standardVideos.map((video, videoIndex) => (
                      <li class="media-card" data-aspect={video.aspect}>
                        <figure>
                          {'bunnyVideoId' in video ? (
                            <BunnyVideo
                              libraryId={bunnyStreamLibraryId}
                              videoId={video.bunnyVideoId}
                              title={`${client.name}, video ${videoIndex + 1}`}
                              aspect={video.aspect}
                            />
                          ) : (
                            <div class="video-frame" data-video-frame data-status="idle">
                              {/* biome-ignore lint/a11y/useMediaCaption: Caption files have not been supplied for the portfolio footage. */}
                              <video
                                data-client-video
                                data-src={video.src}
                                controls
                                playsinline
                                preload="none"
                                aria-label={`${client.name}, video ${videoIndex + 1}`}
                              >
                                <p>
                                  Your browser cannot play this video. <a href={video.src}>Open the video file</a>.
                                </p>
                              </video>
                              <p class="video-status" aria-live="polite">
                                <span data-loading>Loading video</span>
                                <span data-error hidden>Video unavailable</span>
                              </p>
                            </div>
                          )}
                          <figcaption>{video.duration}</figcaption>
                        </figure>
                      </li>
                    ))}
                  </ul>
                </section>
              )}

              {client.reels.length > 0 && (
                <section class="media-group" aria-labelledby={`${client.id}-reels-title`}>
                  <div class="group-heading">
                    <h4 id={`${client.id}-reels-title`}>Reels</h4>
                    <p>{client.reels.length} {client.reels.length === 1 ? 'reel' : 'reels'}</p>
                  </div>
                  <ul
                    class="media-grid reel-grid"
                    id={`${client.id}-reels`}
                    aria-label={`${client.name} reels`}
                  >
                    {client.reels.map((video, videoIndex) => (
                      <li
                        class="media-card"
                        data-aspect={video.aspect}
                        data-extra-reel={videoIndex >= reelPreviewLimit ? '' : undefined}
                        hidden={videoIndex >= reelPreviewLimit}
                      >
                        <figure>
                          {'bunnyVideoId' in video ? (
                            <BunnyVideo
                              libraryId={bunnyStreamLibraryId}
                              videoId={video.bunnyVideoId}
                              title={`${client.name}, reel ${videoIndex + 1}`}
                              aspect={video.aspect}
                            />
                          ) : (
                            <div class="video-frame" data-video-frame data-status="idle">
                              <!-- biome-ignore lint/a11y/useMediaCaption: Caption files have not been supplied for the portfolio footage. -->
                              <video
                                data-client-video
                                data-src={video.src}
                                controls
                                playsinline
                                preload="none"
                                aria-label={`${client.name}, reel ${videoIndex + 1}`}
                              >
                                <p>
                                  Your browser cannot play this video. <a href={video.src}>Open the video file</a>.
                                </p>
                              </video>
                              <p class="video-status" aria-live="polite">
                                <span data-loading>Loading video</span>
                                <span data-error hidden>Video unavailable</span>
                              </p>
                            </div>
                          )}
                          <figcaption>{video.duration}</figcaption>
                        </figure>
                      </li>
                    ))}
                  </ul>
                  {client.reels.length > reelPreviewLimit && (
                    <button
                      class="reel-toggle"
                      type="button"
                      data-reel-toggle
                      data-collapsed-label={`View all ${client.reels.length} reels`}
                      data-expanded-label="Show fewer reels"
                      aria-controls={`${client.id}-reels`}
                      aria-expanded="false"
                    >
                      <span data-reel-toggle-label>View all {client.reels.length} reels</span>
                    </button>
                  )}
                </section>
              )}
            </div>
          </div>
        </TabsContent>
      ))}
    </Tabs>
  </SectionContainer>
</Section>

<script>
const galleries = document.querySelectorAll<HTMLElement>('.work');

galleries.forEach((gallery) => {
  if (gallery.dataset.galleryReady === 'true') return;
  gallery.dataset.galleryReady = 'true';

  const videos = Array.from(gallery.querySelectorAll<HTMLVideoElement>('[data-client-video]'));

  const loadVideo = (video: HTMLVideoElement) => {
    if (video.src || !video.dataset.src) return;

    const frame = video.closest<HTMLElement>('[data-video-frame]');
    if (frame) frame.dataset.status = 'loading';
    video.src = video.dataset.src;
    video.load();
  };

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;

        if (entry.target instanceof HTMLVideoElement) loadVideo(entry.target);
        observer.unobserve(entry.target);
      });
    },
    { rootMargin: '240px', threshold: 0.01 },
  );

  videos.forEach((video) => {
    observer.observe(video);

    video.addEventListener('loadedmetadata', () => {
      const frame = video.closest<HTMLElement>('[data-video-frame]');
      if (frame) frame.dataset.status = 'ready';
    });

    video.addEventListener('error', () => {
      const frame = video.closest<HTMLElement>('[data-video-frame]');
      if (!frame) return;
      frame.dataset.status = 'error';
      frame.querySelector<HTMLElement>('[data-loading]')?.setAttribute('hidden', '');
      frame.querySelector<HTMLElement>('[data-error]')?.removeAttribute('hidden');
    });

    video.addEventListener('play', () => {
      videos.forEach((otherVideo) => {
        if (otherVideo !== video) otherVideo.pause();
      });
    });
  });

  gallery.querySelectorAll<HTMLButtonElement>('[data-reel-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const reelListId = button.getAttribute('aria-controls');
      const reelList = reelListId ? gallery.querySelector<HTMLElement>(`#${reelListId}`) : null;
      if (!reelList) return;

      const isExpanded = button.getAttribute('aria-expanded') === 'true';
      const nextExpanded = !isExpanded;
      const extraReels = reelList.querySelectorAll<HTMLElement>('[data-extra-reel]');
      const label = button.querySelector<HTMLElement>('[data-reel-toggle-label]');

      extraReels.forEach((reel) => {
        reel.hidden = !nextExpanded;
        if (!nextExpanded) reel.querySelector<HTMLVideoElement>('[data-client-video]')?.pause();
      });

      button.setAttribute('aria-expanded', String(nextExpanded));
      if (label) {
        label.textContent = nextExpanded
          ? (button.dataset.expandedLabel ?? 'Show fewer reels')
          : (button.dataset.collapsedLabel ?? 'View all reels');
      }
    });
  });

  const panels = gallery.querySelectorAll<HTMLElement>('[data-slot="tabs-content"]');
  const panelObserver = new MutationObserver((entries) => {
    entries.forEach((entry) => {
      const panel = entry.target as HTMLElement;
      if (!panel.hidden) return;
      panel.querySelectorAll<HTMLVideoElement>('[data-client-video]').forEach((video) => {
        video.pause();
      });
    });
  });

  panels.forEach((panel) => {
    panelObserver.observe(panel, { attributes: true, attributeFilter: ['hidden'] });
  });
});
</script>

<style>
:global(.work) {
  padding-block: 6.5rem 8rem;
  border-top: 1px solid var(--border);
}

.section-heading {
  margin-bottom: 2.75rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

:global(.work-title) {
  font-size: clamp(3.5rem, 6vw, 5.4rem);
  font-weight: 450;
  line-height: 0.96;
  letter-spacing: -0.06em;
}

:global(.work-description) {
  font-size: 1.08rem;
}

:global(.client-tabs) {
  display: flex;
  justify-content: flex-start;
  min-height: 56px;
  overflow-x: auto;
  overflow-y: hidden;
  overscroll-behavior-inline: contain;
  scrollbar-width: none;
}

:global(.client-tabs::-webkit-scrollbar) {
  display: none;
}

:global(.client-tab) {
  flex: 0 0 auto;
  min-width: max-content;
  min-height: 56px;
  padding: 0.9rem clamp(0.8rem, 1.4vw, 1.25rem);
  border-bottom: 1px solid var(--border);
  color: var(--muted-foreground);
  cursor: pointer;
}

:global(.client-tab[data-state="active"]) {
  border-bottom: 3px solid var(--foreground);
  color: var(--foreground);
  font-weight: 620;
}

:global(.client-tab::after) {
  display: none;
}

:global(.client-panel) {
  padding-top: clamp(2.5rem, 5vw, 4.5rem);
}

.client-intro {
  max-width: 40rem;
  margin-bottom: clamp(2.25rem, 4vw, 3.5rem);
}

.client-intro h3 {
  font-size: clamp(1.5rem, 2.2vw, 2rem);
  font-weight: 480;
  letter-spacing: -0.035em;
}

.client-intro > p {
  margin-top: 0.8rem;
  color: var(--muted-foreground);
  font-size: 1.02rem;
  line-height: 1.65;
}

.media-groups {
  display: grid;
  gap: clamp(3.5rem, 7vw, 6rem);
}

.media-group {
  padding-top: 1.25rem;
  border-top: 1px solid var(--border);
}

.group-heading {
  margin-bottom: 1.5rem;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 1rem;
}

.group-heading h4 {
  font-size: clamp(1.25rem, 2vw, 1.65rem);
  font-weight: 540;
  letter-spacing: -0.035em;
}

.group-heading p {
  color: var(--muted-foreground);
  font-size: 0.86rem;
  font-variant-numeric: tabular-nums;
}

.media-grid {
  margin: 0;
  padding: 0;
  display: grid;
  gap: clamp(1rem, 2vw, 1.5rem);
  list-style: none;
}

.video-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.reel-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.video-frame {
  position: relative;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  background: #211317;
}

.reel-grid .video-frame {
  aspect-ratio: 9 / 16;
}

.media-card[data-aspect="square"] .video-frame {
  aspect-ratio: 1;
}

.video-frame video {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: contain;
  background: #211317;
}

.video-status {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  padding: 1rem;
  color: #f1ebdd;
  font-size: 0.85rem;
  letter-spacing: 0.02em;
  pointer-events: none;
  transition: opacity 0.25s var(--portfolio-ease);
}

.video-frame[data-status="idle"] .video-status,
.video-frame[data-status="ready"] .video-status {
  opacity: 0;
}

.video-frame[data-status="error"] .video-status {
  background: #211317;
}

.media-card figcaption {
  padding-top: 0.75rem;
  color: var(--muted-foreground);
  font-size: 0.86rem;
  font-variant-numeric: tabular-nums;
}

.reel-toggle {
  margin-top: 1.75rem;
  padding: 0.7rem 0 0.45rem;
  border-bottom: 1px solid currentColor;
  color: var(--foreground);
  font-size: 0.94rem;
  font-weight: 570;
  cursor: pointer;
  transition:
    color 0.2s var(--portfolio-ease),
    transform 0.2s var(--portfolio-ease);
}

.reel-toggle:hover {
  color: color-mix(in srgb, var(--foreground) 75%, var(--muted-foreground));
}

.reel-toggle:active {
  transform: translateY(1px);
}

.reel-toggle:focus-visible {
  outline: 2px solid var(--foreground);
  outline-offset: 5px;
}

@media (max-width: 700px) {
  :global(.work) {
    padding-block: 4.5rem 5.5rem;
  }

  :global(.work-title) {
    font-size: clamp(3rem, 14vw, 4rem);
  }

  :global(.client-tabs) {
    margin-inline: calc(var(--gutter) * -1);
    width: calc(100% + (var(--gutter) * 2));
    padding-inline: var(--gutter);
  }

  .client-intro {
    margin-bottom: 2rem;
  }

  .media-groups {
    gap: 3.5rem;
  }

  .video-grid {
    grid-template-columns: 1fr;
  }

  .reel-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
</style>
