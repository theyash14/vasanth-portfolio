---
import {
  Section,
  SectionContainer,
  SectionDescription,
  SectionTitle,
} from '@/components/ui/section';
import { Tabs, TabsContent, TabsList, TabsTrigger } from '@/components/ui/tabs';
import { bunnyStreamLibraryId, clients } from '../../data/portfolio';
import BunnyVideo from './BunnyVideo.astro';

const clientCollections = clients.map((client) => ({
  ...client,
  standardVideos: client.videos.filter((video) => video.format === 'video'),
  reels: client.videos.filter((video) => video.format === 'reel'),
}));
---

<Section class="work" id="work" aria-labelledby="work-title">
  <SectionContainer class="shell max-w-none gap-0 px-0">
    <div class="section-heading">
      <SectionTitle as="h2" class="work-title" id="work-title"> Client edits </SectionTitle>
      <SectionDescription class="work-description">
        Thirty-eight videos, organised by client and body of work.
      </SectionDescription>
    </div>

    <Tabs defaultValue={clientCollections[0]?.id} class="gap-0">
      <TabsList variant="line" class="client-tabs h-auto w-full rounded-none p-0">
        {clientCollections.map((client) => (
          <TabsTrigger id={`${client.id}-tab`} class="client-tab" value={client.id}>
            {client.tab}
          </TabsTrigger>
        ))}
      </TabsList>

      {clientCollections.map((client, index) => (
        <TabsContent value={client.id} hidden={index !== 0}>
          <div class="client-panel">
            <div class="client-intro">
              <h3>{client.name}</h3>
              <p>{client.summary}</p>
            </div>

            <div class="media-groups">
              {client.standardVideos.length > 0 && (
                <section class="media-group" aria-labelledby={`${client.id}-videos-title`}>
                  <div class="group-heading">
                    <h4 id={`${client.id}-videos-title`}>Videos</h4>
                    <p>{client.standardVideos.length} {client.standardVideos.length === 1 ? 'video' : 'videos'}</p>
                  </div>
                  <ul class="media-grid video-grid" aria-label={`${client.name} standard videos`}>
                    {client.standardVideos.map((video, videoIndex) => (
                      <li class="media-card" data-aspect={video.aspect}>
                        <figure>
                          <BunnyVideo
                            libraryId={bunnyStreamLibraryId}
                            videoId={video.bunnyVideoId}
                            title={`${client.name}, video ${videoIndex + 1}`}
                            aspect={video.aspect}
                          />
                        </figure>
                      </li>
                    ))}
                  </ul>
                </section>
              )}

              {client.reels.length > 0 && (
                <section class="media-group" aria-labelledby={`${client.id}-reels-title`}>
                  <div class="group-heading">
                    <h4 id={`${client.id}-reels-title`}>Reels</h4>
                    <p>{client.reels.length} {client.reels.length === 1 ? 'reel' : 'reels'}</p>
                  </div>
                  <ul
                    class="media-grid reel-grid"
                    id={`${client.id}-reels`}
                    aria-label={`${client.name} reels`}
                  >
                    {client.reels.map((video, videoIndex) => (
                      <li class="media-card" data-aspect={video.aspect}>
                        <figure>
                          <BunnyVideo
                            libraryId={bunnyStreamLibraryId}
                            videoId={video.bunnyVideoId}
                            title={`${client.name}, reel ${videoIndex + 1}`}
                            aspect={video.aspect}
                          />
                        </figure>
                      </li>
                    ))}
                  </ul>
                </section>
              )}
            </div>
          </div>
        </TabsContent>
      ))}
    </Tabs>
  </SectionContainer>
</Section>

<style>
:global(.work) {
  padding-block: 6.5rem 8rem;
  border-top: 1px solid var(--border);
}

.section-heading {
  margin-bottom: 2.75rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

:global(.work-title) {
  font-size: clamp(3.5rem, 6vw, 5.4rem);
  font-weight: 450;
  line-height: 0.96;
  letter-spacing: -0.06em;
}

:global(.work-description) {
  font-size: 1.08rem;
}

:global(.client-tabs) {
  display: flex;
  justify-content: flex-start;
  min-height: 56px;
  overflow-x: auto;
  overflow-y: hidden;
  overscroll-behavior-inline: contain;
  scrollbar-width: none;
}

:global(.client-tabs::-webkit-scrollbar) {
  display: none;
}

:global(.client-tab) {
  flex: 0 0 auto;
  min-width: max-content;
  min-height: 56px;
  padding: 0.9rem clamp(0.8rem, 1.4vw, 1.25rem);
  border-bottom: 1px solid var(--border);
  color: var(--muted-foreground);
  cursor: pointer;
}

:global(.client-tab[data-state="active"]) {
  border-bottom: 3px solid var(--foreground);
  color: var(--foreground);
  font-weight: 620;
}

:global(.client-tab::after) {
  display: none;
}

:global(.client-panel) {
  padding-top: clamp(2.5rem, 5vw, 4.5rem);
}

.client-intro {
  max-width: 40rem;
  margin-bottom: clamp(2.25rem, 4vw, 3.5rem);
}

.client-intro h3 {
  font-size: clamp(1.5rem, 2.2vw, 2rem);
  font-weight: 480;
  letter-spacing: -0.035em;
}

.client-intro > p {
  margin-top: 0.8rem;
  color: var(--muted-foreground);
  font-size: 1.02rem;
  line-height: 1.65;
}

.media-groups {
  display: grid;
  gap: clamp(3.5rem, 7vw, 6rem);
}

.media-group {
  padding-top: 1.25rem;
  border-top: 1px solid var(--border);
}

.group-heading {
  margin-bottom: 1.5rem;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 1rem;
}

.group-heading h4 {
  font-size: clamp(1.25rem, 2vw, 1.65rem);
  font-weight: 540;
  letter-spacing: -0.035em;
}

.group-heading p {
  color: var(--muted-foreground);
  font-size: 0.86rem;
  font-variant-numeric: tabular-nums;
}

.media-grid {
  margin: 0;
  padding: 0;
  display: grid;
  gap: clamp(1rem, 2vw, 1.5rem);
  list-style: none;
}

.video-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.reel-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

@media (max-width: 700px) {
  :global(.work) {
    padding-block: 4.5rem 5.5rem;
  }

  :global(.work-title) {
    font-size: clamp(3rem, 14vw, 4rem);
  }

  :global(.client-tabs) {
    margin-inline: calc(var(--gutter) * -1);
    width: calc(100% + (var(--gutter) * 2));
    padding-inline: var(--gutter);
  }

  .client-intro {
    margin-bottom: 2rem;
  }

  .media-groups {
    gap: 3.5rem;
  }

  .video-grid {
    grid-template-columns: 1fr;
  }

  .reel-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
</style>
