---
import { Icon } from "astro-icon/components";
import { Button } from "@/components/ui/button";
import { Field, FieldGroup, FieldLabel } from "@/components/ui/field";
import { Form } from "@/components/ui/form";
import { Input } from "@/components/ui/input";
import {
    Section,
    SectionContainer,
    SectionTitle,
} from "@/components/ui/section";
import { Separator } from "@/components/ui/separator";
import { Textarea } from "@/components/ui/textarea";
import { PROJECT_TYPES } from "@/lib/contact";
import { profile } from "../../data/portfolio";

const socialLinks = [
    {
        label: "LinkedIn",
        href: profile.linkedin,
        icon: "linkedin",
    },
    {
        label: "WhatsApp",
        href: profile.whatsapp,
        icon: "thesvg:whatsapp",
    },
    {
        label: "Instagram",
        href: profile.instagram,
        icon: "thesvg:instagram",
    },
].filter((link) => link.href && link.href !== "#");

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim();
---

<Section
    class="contact gap-0 py-0"
    id="contact"
    aria-labelledby="contact-title"
>
    <Separator class="bg-foreground" />
    <SectionContainer class="shell max-w-none gap-0 px-0">
        <div class="contact-layout">
            <div class="contact-introduction">
                <header class="contact-heading">
                    <SectionTitle
                        as="h2"
                        class="contact-title"
                        id="contact-title"
                    >
                        Your next
                        <br />
                        great edit.
                        <span class="title-invitation">Let’s talk.</span>
                    </SectionTitle>
                    <p>
                        Have footage, an idea, or a story to tell? Let’s give it
                        the edit it deserves.
                    </p>
                </header>
                <div class="direct-contact">
                    <span class="aside-label">Or drop me a line</span>
                    <a href={`mailto:${profile.email}`}>
                        <Icon
                            name="reicon:envelope"
                            class="size-[21px]"
                            aria-hidden="true"
                        />
                        <span>{profile.email}</span>
                        <Icon
                            name="reicon:arrow-up-right"
                            class="size-[20px]"
                            aria-hidden="true"
                        />
                    </a>
                </div>
                {socialLinks.length > 0 && (
                    <ul class="social-links" aria-label="Social profiles">
                        {socialLinks.map(({ icon, href, label }) => (
                            <li>
                                <a href={href}>
                                    <Icon
                                        name={icon}
                                        class="size-[18px]"
                                        aria-hidden="true"
                                    />
                                    {label}
                                    <Icon
                                        name="reicon:arrow-up-right"
                                        class="size-[16px]"
                                        aria-hidden="true"
                                    />
                                </a>
                            </li>
                        ))}
                    </ul>
                )}
            </div>
            <div class="form-panel">
                <div class="form-intro">
                    <h3>A little about your project</h3>
                    <p>A few details are all we need to start.</p>
                </div>

                <Form
                    class="contact-form"
                    data-contact-form
                    method="post"
                    action="/api/contact"
                    aria-busy="false"
                >
                    <FieldGroup class="contact-fields">
                        <div class="field-row">
                            <Field>
                                <FieldLabel for="contact-name">
                                    {" "}
                                    Your name{" "}
                                </FieldLabel>
                                <Input
                                    id="contact-name"
                                    name="name"
                                    autocomplete="name"
                                    minlength={2}
                                    maxlength={80}
                                    required
                                />
                            </Field>

                            <Field>
                                <FieldLabel for="contact-email">
                                    {" "}
                                    Email address{" "}
                                </FieldLabel>
                                <Input
                                    id="contact-email"
                                    name="email"
                                    type="email"
                                    autocomplete="email"
                                    inputmode="email"
                                    maxlength={254}
                                    required
                                />
                            </Field>
                        </div>

                        <fieldset class="project-choices">
                            <legend>What are we making?</legend>
                            <div class="choice-list">
                                {PROJECT_TYPES.map((type) => (
                                    <label class="project-choice">
                                        <input
                                            type="radio"
                                            name="projectType"
                                            value={type}
                                            required
                                        />
                                        <span>{type}</span>
                                    </label>
                                ))}
                            </div>
                        </fieldset>

                        <Field>
                            <FieldLabel for="contact-deadline">
                                {" "}
                                Deadline, if fixed{" "}
                            </FieldLabel>
                            <Input
                                id="contact-deadline"
                                name="deadline"
                                placeholder="e.g. 20 October"
                                maxlength={100}
                            />
                        </Field>
                        <Field>
                            <FieldLabel for="contact-details">
                                {" "}
                                Project details{" "}
                            </FieldLabel>
                            <Textarea
                                id="contact-details"
                                name="details"
                                rows={6}
                                placeholder="The idea, the audience, the feeling. Reference links welcome."
                                minlength={20}
                                maxlength={3000}
                                required
                            />
                        </Field>

                        <div class="honeypot" aria-hidden="true">
                            <label for="contact-company">Company website</label>
                            <input
                                id="contact-company"
                                name="company"
                                type="text"
                                tabindex="-1"
                                autocomplete="off"
                            />
                        </div>

                        {turnstileSiteKey ? (
                            <div
                                class="cf-turnstile"
                                data-sitekey={turnstileSiteKey}
                                data-action="contact"
                                data-theme="auto"
                                data-size="normal"
                            ></div>
                        ) : (
                            <p class="configuration-notice">
                                Verification is temporarily unavailable. Please
                                use the email link instead.
                            </p>
                        )}
                    </FieldGroup>

                    <div class="form-action">
                        <Button class="submit-button" type="submit">
                            <span data-submit-label>Let’s make it happen</span>
                            <Icon
                                name="reicon:send"
                                class="size-[21px]"
                                aria-hidden="true"
                            />
                        </Button>
                        <p class="form-note">
                            Your details are sent securely to my inbox.
                        </p>
                        <p
                            class="form-status"
                            data-form-status
                            aria-live="polite"
                            tabindex="-1"
                            hidden
                        ></p>
                        <p class="error-fallback" data-error-fallback hidden>
                            Prefer email?{" "}
                            <a href={`mailto:${profile.email}`}>
                                Send your inquiry in Gmail.
                            </a>
                        </p>
                    </div>
                </Form>
            </div>
        </div>

        <Separator class="footer-separator" />
        <footer>
            <span>© {new Date().getFullYear()} Vasanth</span>
            <a href="#top">
                Back to top
                <Icon
                    name="reicon:arrow-up"
                    class="size-[16px]"
                    aria-hidden="true"
                />
            </a>
        </footer>
    </SectionContainer>
</Section>

{turnstileSiteKey && (
    <script
        is:inline
        src="https://challenges.cloudflare.com/turnstile/v0/api.js"
        async
        defer
    ></script>
)}

<script>
    const contactForm = document.querySelector<HTMLFormElement>(
        "[data-contact-form]",
    );

    if (contactForm && contactForm.dataset.contactReady !== "true") {
        contactForm.dataset.contactReady = "true";

        const submitButton = contactForm.querySelector<HTMLButtonElement>(
            'button[type="submit"]',
        );
        const submitLabel = contactForm.querySelector<HTMLElement>(
            "[data-submit-label]",
        );
        const status =
            contactForm.querySelector<HTMLElement>("[data-form-status]");
        const fallback = contactForm.querySelector<HTMLElement>(
            "[data-error-fallback]",
        );
        let submitting = false;

        const resetTurnstile = () => {
            const turnstile = (
                window as Window & {
                    turnstile?: {
                        reset: (widget?: string | HTMLElement) => void;
                    };
                }
            ).turnstile;
            if (turnstile) turnstile.reset();
        };

        const setStatus = (message: string, state: "success" | "error") => {
            if (!status) return;
            status.textContent = message;
            status.dataset.state = state;
            status.hidden = false;
            if (state === "error") status.focus();
        };

        contactForm.addEventListener("submit", async (event) => {
            event.preventDefault();

            if (submitting || !contactForm.reportValidity()) return;

            submitting = true;
            contactForm.setAttribute("aria-busy", "true");
            if (submitButton) submitButton.disabled = true;
            if (submitLabel) submitLabel.textContent = "Sending…";
            if (status) status.hidden = true;
            if (fallback) fallback.hidden = true;

            const formData = new FormData(contactForm);
            const payload = Object.fromEntries(formData.entries());

            try {
                const response = await fetch(contactForm.action, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload),
                });
                const result = (await response.json().catch(() => null)) as {
                    message?: string;
                } | null;

                if (!response.ok) {
                    throw new Error(
                        result?.message || "The message could not be sent.",
                    );
                }

                contactForm.reset();
                setStatus(
                    "Thanks — your project details are on their way.",
                    "success",
                );
            } catch (error) {
                setStatus(
                    error instanceof Error
                        ? error.message
                        : "The message could not be sent. Please try again.",
                    "error",
                );
                if (fallback) fallback.hidden = false;
            } finally {
                resetTurnstile();
                submitting = false;
                contactForm.setAttribute("aria-busy", "false");
                if (submitButton) submitButton.disabled = false;
                if (submitLabel)
                    submitLabel.textContent = "Let’s make it happen";
            }
        });
    }
</script>

<style>
    :global(.contact) {
        padding-top: 6rem;
    }
    .contact-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: clamp(3rem, 8vw, 8rem);
        padding-top: clamp(3rem, 6vw, 6rem);
    }
    .contact-introduction {
        min-width: 0;
    }
    :global(.contact-title) {
        font-size: clamp(3.6rem, 6.3vw, 6rem);
        font-weight: 450;
        line-height: 0.98;
        letter-spacing: -0.065em;
    }
    .title-invitation {
        display: block;
        margin-top: 0.18em;
        color: var(--portfolio-player-accent);
    }
    .contact-heading p {
        max-width: 32ch;
        margin-top: 2rem;
        color: var(--muted-foreground);
        font-size: 1.08rem;
        line-height: 1.7;
    }
    .direct-contact {
        margin-top: clamp(3rem, 5vw, 5rem);
    }
    .aside-label {
        display: block;
        margin-bottom: 0.9rem;
        color: var(--muted-foreground);
        font-size: 0.85rem;
    }
    .direct-contact a {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        width: fit-content;
        max-width: 100%;
        font-size: clamp(1rem, 1.7vw, 1.4rem);
        letter-spacing: -0.025em;
    }
    .direct-contact a span {
        overflow-wrap: anywhere;
        min-width: 0;
    }
    .direct-contact a :global(svg) {
        flex-shrink: 0;
    }
    .social-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        padding: 0;
        margin-top: 2rem;
        list-style: none;
    }
    .social-links a {
        display: flex;
        align-items: center;
        min-height: 44px;
        gap: 0.5rem;
        font-size: 0.85rem;
    }
    .direct-contact a :global(svg:last-child),
    .social-links a :global(svg:last-child) {
        transition: transform 0.2s var(--portfolio-ease);
    }
    .direct-contact a:hover :global(svg:last-child),
    .social-links a:hover :global(svg:last-child) {
        transform: translate(2px, -2px);
    }
    .form-panel {
        min-width: 0;
        padding-top: 0.45rem;
    }
    .form-intro {
        margin-bottom: 2.5rem;
    }
    .form-intro h3 {
        font-size: clamp(1.5rem, 2.2vw, 2rem);
        font-weight: 500;
        line-height: 1.2;
        letter-spacing: -0.045em;
    }
    .form-intro p {
        margin-top: 0.6rem;
        font-size: 0.9rem;
        color: var(--muted-foreground);
    }
    :global(.contact-form) {
        gap: 2rem;
    }
    :global(.contact-fields) {
        gap: 1.8rem;
    }
    .honeypot {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }
    .field-row {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.5rem;
    }
    :global(.contact-form [data-slot="field"]) {
        gap: 0.65rem;
    }
    :global(.contact-form [data-slot="field-label"]),
    .project-choices legend {
        font-size: 0.85rem;
        font-weight: 550;
        color: var(--foreground);
    }
    :global(.contact-form [data-slot="input"]),
    :global(.contact-form [data-slot="textarea"]) {
        width: 100%;
        min-height: 3.1rem;
        border: 1px solid var(--border);
        border-radius: var(--portfolio-media-radius);
        background: color-mix(in srgb, var(--background) 65%, var(--secondary));
        color: var(--foreground);
        box-shadow: none;
        padding: 0.8rem 0.9rem;
        font: inherit;
        font-size: 1rem;
        outline: none;
        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease;
    }
    :global(.contact-form [data-slot="textarea"]) {
        min-height: 8rem;
        resize: vertical;
        line-height: 1.5;
    }
    :global(.contact-form [data-slot="input"]:focus-visible),
    :global(.contact-form [data-slot="textarea"]:focus-visible) {
        border-color: var(--foreground);
        box-shadow: 0 0 0 2px var(--foreground);
    }
    :global(.contact-form [data-slot="input"]::placeholder),
    :global(.contact-form [data-slot="textarea"]::placeholder) {
        color: var(--muted-foreground);
        opacity: 1;
    }
    .project-choices {
        border: 0;
        margin: 0;
        padding: 0;
        min-width: 0;
    }
    .project-choices legend {
        margin-bottom: 0.85rem;
    }
    .choice-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
    }
    .project-choice {
        position: relative;
        cursor: pointer;
    }
    .project-choice input {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
    }
    .choice-list .project-choice span {
        display: flex;
        align-items: center;
        min-height: 44px;
        padding: 0.65rem 0.85rem;
        border: 1px solid var(--border);
        border-radius: var(--portfolio-media-radius);
        font-size: 0.83rem;
        transition:
            background-color 0.2s ease,
            color 0.2s ease,
            border-color 0.2s ease;
    }
    .choice-list .project-choice:hover span {
        border-color: var(--foreground);
    }
    .choice-list .project-choice input:checked + span {
        background: var(--foreground);
        color: var(--background);
        border-color: var(--foreground);
    }
    .choice-list .project-choice input:focus-visible + span {
        outline: 2px solid var(--foreground);
        outline-offset: 3px;
    }
    .form-action {
        display: grid;
        gap: 0.9rem;
    }
    .cf-turnstile {
        width: fit-content;
        max-width: 100%;
        min-height: 65px;
    }
    .configuration-notice,
    .form-status,
    .error-fallback {
        font-size: 0.85rem;
        line-height: 1.55;
    }
    .configuration-notice,
    .form-status[data-state="error"],
    .error-fallback {
        color: var(--destructive);
    }
    .form-status[data-state="success"] {
        color: var(--foreground);
    }
    .form-status:focus {
        outline: none;
    }
    .error-fallback a {
        color: var(--foreground);
        text-decoration: underline;
        text-underline-offset: 0.22em;
    }
    :global(.submit-button) {
        display: flex;
        justify-content: space-between;
        width: 100%;
        height: auto;
        min-height: 3.5rem;
        padding: 1rem 1.2rem;
        border-radius: var(--portfolio-media-radius);
        background: var(--foreground);
        color: var(--background);
        font-size: 1rem;
        font-weight: 500;
        box-shadow: none;
        transition:
            background-color 0.2s ease,
            transform 0.2s ease;
    }
    :global(.submit-button:hover) {
        background: color-mix(
            in srgb,
            var(--foreground) 88%,
            var(--background)
        );
    }
    :global(.submit-button:active) {
        transform: translateY(1px);
    }
    :global(.submit-button:disabled) {
        cursor: wait;
        opacity: 0.7;
        transform: none;
    }
    .form-note {
        color: var(--muted-foreground);
        font-size: 0.78rem;
        line-height: 1.5;
    }
    :global(.footer-separator) {
        margin-top: clamp(4rem, 7vw, 7rem);
    }
    footer {
        min-height: 90px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        color: var(--muted-foreground);
        font-size: 0.85rem;
    }
    footer a[href="#top"] {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        gap: 0.45rem;
    }
    @media (max-width: 900px) {
        .contact-layout {
            grid-template-columns: 1fr;
            gap: 3.5rem;
        }
        :global(.contact-title) {
            font-size: clamp(3.7rem, 9vw, 5.5rem);
        }
        .contact-heading p {
            max-width: 42ch;
        }
        .direct-contact {
            margin-top: 2rem;
        }
        .form-panel {
            border-top: 1px solid var(--border);
            padding-top: 2.5rem;
        }
    }
    @media (max-width: 540px) {
        :global(.contact) {
            padding-top: 4rem;
        }
        :global(.contact-title) {
            font-size: clamp(3.1rem, 13vw, 4.5rem);
        }
        .field-row {
            grid-template-columns: 1fr;
            gap: 1.8rem;
        }
        .form-intro {
            margin-bottom: 2rem;
        }
    }
</style>
