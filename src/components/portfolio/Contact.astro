---
import { Icon } from "astro-icon/components";
import {
    Section,
    SectionContainer,
    SectionTitle,
} from "@/components/ui/section";
import { Separator } from "@/components/ui/separator";
import { profile } from "../../data/portfolio";

const socialLinks = [
    { label: "LinkedIn", href: profile.linkedin, icon: "linkedin" },
    { label: "WhatsApp", href: profile.whatsapp, icon: "thesvg:whatsapp" },
    { label: "Instagram", href: profile.instagram, icon: "thesvg:instagram" },
].filter((link) => link.href && link.href !== "#");
---

<Section
    class="contact gap-0 py-0"
    id="contact"
    aria-labelledby="contact-title"
>
    <SectionContainer class="shell max-w-none gap-0 px-0">
        <div class="contact-layout">
            <SectionTitle as="h2" class="contact-title" id="contact-title">
                Your next
                <br />
                great edit.
                <span class="title-invitation">Let’s talk.</span>
            </SectionTitle>

            <div class="contact-actions">
                <p class="contact-description">
                    Have a project in mind?
                    <br />
                    Let’s shape it together.
                </p>
                <a
                    class="booking-button"
                    href={profile.calUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <span>Book a call</span>
                    <Icon
                        name="reicon:arrow-up-right"
                        class="size-[21px]"
                        aria-hidden="true"
                    />
                </a>
                <p class="direct-contact">
                    <span>Prefer email?</span>
                    <a href={`mailto:${profile.email}`}>
                        Send me a brief
                        <Icon
                            name="reicon:arrow-up-right"
                            class="size-[16px]"
                            aria-hidden="true"
                        />
                    </a>
                </p>
                {socialLinks.length > 0 && (
                    <ul class="social-links" aria-label="Social profiles">
                        {socialLinks.map(({ icon, href, label }) => (
                            <li>
                                <a href={href}>
                                    <Icon
                                        name={icon}
                                        class="size-[18px]"
                                        aria-hidden="true"
                                    />
                                    {label}
                                    <Icon
                                        name="reicon:arrow-up-right"
                                        class="size-[16px]"
                                        aria-hidden="true"
                                    />
                                </a>
                            </li>
                        ))}
                    </ul>
                )}
            </div>
        </div>

        <Separator class="footer-separator" />
        <footer>
            <span>© {new Date().getFullYear()} Vasanth</span>
            <a href="#top">
                Back to top
                <Icon
                    name="reicon:arrow-up"
                    class="size-[16px]"
                    aria-hidden="true"
                />
            </a>
        </footer>
    </SectionContainer>
</Section>

<style>
    :global(.contact) {
        --background: #451722;
        --foreground: #f1ebdd;
        --muted-foreground: #cbb6b4;
        --border: #79535a;
        background: var(--background);
        color: var(--foreground);
        padding-block: 0;
    }
    .contact-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
        gap: clamp(3rem, 7vw, 7rem);
        align-items: center;
        padding-block: clamp(5rem, 8vw, 8rem);
    }
    .contact-actions {
        min-width: 0;
        max-width: 28rem;
        width: 100%;
        justify-self: end;
    }
    :global(.contact-title) {
        font-size: clamp(3.6rem, 7.5vw, 7.25rem);
        font-weight: 450;
        line-height: 0.98;
        letter-spacing: -0.065em;
    }
    .title-invitation {
        display: block;
        margin-top: 0.18em;
        color: #d993a5;
    }
    .contact-description {
        max-width: 34ch;
        margin-bottom: 2rem;
        color: var(--foreground);
        font-size: clamp(1.125rem, 1.6vw, 1.4rem);
        line-height: 1.55;
    }
    .direct-contact {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0 0.4rem;
        margin-top: 0.75rem;
        color: var(--muted-foreground);
        font-size: 0.9rem;
    }
    .direct-contact a {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        min-height: 44px;
        color: var(--foreground);
        text-decoration: underline;
        text-underline-offset: 0.25em;
    }
    .social-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        padding: 0;
        margin-top: 1.5rem;
        list-style: none;
    }
    .social-links a {
        display: flex;
        align-items: center;
        min-height: 44px;
        gap: 0.5rem;
        font-size: 0.85rem;
        color: var(--muted-foreground);
        transition: color 0.2s ease;
    }
    .social-links a:hover {
        color: var(--foreground);
    }
    .direct-contact a :global(svg:last-child),
    .social-links a :global(svg:last-child) {
        transition: transform 0.2s var(--portfolio-ease);
    }
    .direct-contact a:hover :global(svg:last-child),
    .social-links a:hover :global(svg:last-child) {
        transform: translate(2px, -2px);
    }
    .booking-button {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        width: 100%;
        min-height: 3.75rem;
        padding: 1rem 1.2rem;
        border-radius: var(--portfolio-media-radius);
        background: var(--foreground);
        color: var(--background);
        font-size: 1rem;
        font-weight: 500;
        transition:
            background-color 0.2s ease,
            transform 0.2s ease;
    }
    .booking-button:hover {
        background: color-mix(
            in srgb,
            var(--foreground) 88%,
            var(--background)
        );
        transform: translateY(-2px);
    }
    .booking-button:focus-visible {
        outline: 2px solid var(--foreground);
        outline-offset: 3px;
    }
    footer {
        min-height: 88px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        color: var(--muted-foreground);
        font-size: 0.85rem;
    }
    footer a[href="#top"] {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        gap: 0.45rem;
    }
    @media (max-width: 760px) {
        .contact-layout {
            grid-template-columns: 1fr;
            gap: 3rem;
            padding-block: 4.5rem;
        }
        :global(.contact-title) {
            font-size: clamp(3.7rem, 12vw, 6rem);
        }
        .contact-actions {
            width: 100%;
            max-width: none;
        }
    }
    @media (max-width: 540px) {
        :global(.contact-title) {
            font-size: clamp(3.5rem, 14vw, 4.75rem);
        }
    }
</style>
