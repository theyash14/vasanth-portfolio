---
import { Button } from '@/components/starwind/button';

const { href, compact = false, ...props } = Astro.props;
const className = compact ? 'portfolio-button portfolio-button--compact' : 'portfolio-button';
---

<Button href={href} class={className} {...props}>
  <slot />
</Button>

<style>
:global(.portfolio-button) {
  min-height: 52px;
  justify-content: space-between;
  gap: 2.25rem;
  padding: 0.85rem 1.4rem;
  border-radius: var(--portfolio-button-radius);
  background: var(--foreground);
  color: var(--background);
  transition:
    transform 0.25s var(--portfolio-ease),
    background 0.25s var(--portfolio-ease);
}

:global(.portfolio-button:hover) {
  background: #5a2230;
  transform: translateY(-2px);
}

:global(.portfolio-button--compact) {
  min-height: 44px;
  gap: 1.5rem;
  padding: 0.65rem 1.15rem;
}

@media (max-width: 700px) {
  :global(.portfolio-button--compact) {
    min-height: 40px;
  }
}

@media (max-width: 430px) {
  :global(.portfolio-button--compact) {
    gap: 0.75rem;
    padding-inline: 0.85rem;
  }
}
</style>
