---
---

<section class="recognition shell" id="recognition" aria-labelledby="award-title">
  <div
    class="award-image"
    role="img"
    aria-label="Placeholder for Vasanth's Best Editor award photograph"
  >
    <div class="award-image-content">
      <span aria-hidden="true" class="award-mark">▣</span>
      <span>Award photograph</span>
      <span>Add your Best Editor award moment</span>
    </div>
  </div>
  <div class="award-copy">
    <h2 class="award-title" id="award-title"> Best Editor<br>Award </h2>
    <p class="award-meta">[ Award organisation ] / [ Year ]</p>
    <p class="award-description">
      A proud moment in the journey. A reminder to keep creating work that connects, challenges, and
      stays with people.
    </p>
  </div>
</section>

<style>
:global(.recognition) {
  min-height: 620px;
  padding-block: 6.5rem;
  display: grid;
  grid-template-columns: 1.3fr 0.8fr;
  align-items: center;
  gap: clamp(4rem, 8vw, 8rem);
}

:global(.award-image) {
  min-height: 450px;
  background: var(--portfolio-media);
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.award-image-content { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
.award-image-content span:last-child { color: var(--muted-foreground); font-size: 0.875rem; }

.award-mark {
  color: #8f785d;
  font-size: 1.8rem;
}

.award-copy {
  max-width: 29rem;
}

:global(.award-title) {
  font-size: clamp(3.5rem, 6vw, 5.4rem);
  font-weight: 450;
  line-height: 0.96;
  letter-spacing: -0.06em;
}

.award-meta {
  margin-block: 2rem 1.25rem;
  color: var(--muted-foreground);
  font-size: 0.95rem;
}

:global(.award-description) {
  color: var(--muted-foreground);
  font-size: 1.08rem;
  line-height: 1.65;
}

@media (max-width: 900px) {
  :global(.recognition) {
    gap: 3rem;
  }
}

@media (max-width: 700px) {
  .recognition {
    min-height: auto;
    padding-block: 5.5rem;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  :global(.award-title) {
    font-size: clamp(3rem, 14vw, 4rem);
  }

  :global(.award-image) {
    min-height: 340px;
  }
}
</style>
