---
import { Image } from 'astro:assets';
import BEAward from '@/assets/images/BE.png';
---

<section class="recognition shell" id="recognition" aria-labelledby="award-title">
  <Image
    class="award-image"
    src={BEAward}
    alt="Vasanth's Best Editor award and certificate from Vimi Magic"
  />
  <div class="award-copy">
    <h2 class="award-title" id="award-title">
      Best Editor
      <br>
      Award
    </h2>
    <p class="award-meta">Vimi Magic — 2025</p>
    <p class="award-description">
      A proud moment in the journey. A reminder to keep creating work that connects, challenges, and
      stays with people.
    </p>
  </div>
</section>

<style>
:global(.recognition) {
  min-height: 620px;
  padding-block: 6.5rem;
  display: grid;
  grid-template-columns: 1.3fr 0.8fr;
  align-items: center;
  gap: clamp(4rem, 8vw, 8rem);
}

.award-image {
  width: 100%;
  height: auto;
  border-radius: 1.75rem;
}

.award-copy {
  max-width: 29rem;
}

:global(.award-title) {
  font-size: clamp(3.5rem, 6vw, 5.4rem);
  font-weight: 450;
  line-height: 0.96;
  letter-spacing: -0.06em;
}

.award-meta {
  margin-block: 2rem 1.25rem;
  color: var(--muted-foreground);
  font-size: 0.95rem;
}

:global(.award-description) {
  color: var(--muted-foreground);
  font-size: 1.08rem;
  line-height: 1.65;
}

@media (max-width: 900px) {
  :global(.recognition) {
    gap: 3rem;
  }
}

@media (max-width: 700px) {
  .recognition {
    min-height: auto;
    padding-block: 5.5rem;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  :global(.award-title) {
    font-size: clamp(3rem, 14vw, 4rem);
  }
}
</style>
