---
import '@fontsource-variable/geist';
import '../styles/global.css';
import '../styles/portfolio-theme.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Vasanth | Video editor, animator and AI editor',
  description = 'Video editing, motion graphics, colour and AI-assisted post-production by Vasanth.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <meta name="generator" content={Astro.generator}>
    <meta name="description" content={description}>
    <meta name="theme-color" content="#f1ebdd">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content="website">
    <title>{title}</title>
  </head>
  <body class="@container">
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>

<style>
html,
body {
  margin: 0;
  width: 100%;
  min-height: 100%;
}
</style>
