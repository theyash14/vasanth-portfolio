{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-09-11",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "vasanth-portfolio",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAE8pPRlzuzZxcq4Y",
		"CONTACT_FROM_EMAIL": "contact@vasanthsrinivas.com",
		"CONTACT_TO_EMAIL": "vasanthramesh.che@gmail.com"
	}
}